{
  "opencollection": "1.0.0",
  "info": {
    "name": "Apify Actor Runs Users API",
    "version": "v2"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Users",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Apify Get Current User",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.apify.com/v2/users/me"
          },
          "docs": "Returns information about the authenticated user."
        }
      ]
    }
  ],
  "bundled": true
}