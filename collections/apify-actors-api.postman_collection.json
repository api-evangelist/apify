            },
            "url": {
              "path": [
                "acts",
                ":actorId",
                "runs"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "waitForFinish",
                  "value": "<integer>",
                  "description": "Wait for run to finish (max 300 seconds). Returns run details when complete."
                },
                {
                  "disabled": false,
                  "key": "memory",
                  "value": "<integer>",
                  "description": "Memory limit in MB (128-32768)."
                },
                {
                  "disabled": false,
                  "key": "build",
                  "value": "<string>",
                  "description": "Tag or number of the Actor build to run."
                }
              ],
              "variable": [
                {
                  "disabled": false,
