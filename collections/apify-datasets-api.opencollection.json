{
  "opencollection": "1.0.0",
  "info": {
    "name": "Apify Actor Runs Datasets API",
    "version": "v2"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Datasets",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Apify List Datasets",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.apify.com/v2/datasets",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of results."
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Number of results to skip."
              }
            ]
          },
          "docs": "Returns a list of datasets owned by the user."
        },
        {
          "info": {
            "name": "Apify Get Dataset Items",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.apify.com/v2/datasets/:datasetId/items",
            "params": [
              {
                "name": "datasetId",
                "value": "",
                "type": "path",
                "description": "Dataset ID."
              },
              {
                "name": "format",
                "value": "",
                "type": "query",
                "description": "Output format (json, csv, xml, html, rss, xlsx, jsonl)."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of items."
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Number of items to skip."
              },
              {
                "name": "fields",
                "value": "",
                "type": "query",
                "description": "Comma-separated list of fields to include."
              }
            ]
          },
          "docs": "Returns items stored in a dataset. Supports multiple output formats."
        }
      ]
    }
  ],
  "bundled": true
}